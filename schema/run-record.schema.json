{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ddvnguyen/expert-metrics/schema/run-record.schema.json",
  "title": "Expert probe run record",
  "description": "One per-probe record from the expert-atlas sweep harness. Honest-state: telemetry:false records are valid and expected pre-Stage-A.",
  "type": "object",
  "required": ["schema_version", "run_id", "category", "idx", "telemetry", "provenance"],
  "properties": {
    "schema_version": { "const": 1 },
    "run_id": { "type": "string", "pattern": "^[0-9]{8}T[0-9]{6}Z-[a-z0-9-]+$" },
    "category": { "type": "string" },
    "idx": { "type": "integer", "minimum": 0 },
    "prompt_id": { "type": "string" },
    "telemetry": { "type": "boolean" },
    "selections": {
      "description": "expert key 'row:col' -> selection count (delta over the probe). Present iff telemetry true.",
      "type": "object",
      "propertyNames": { "pattern": "^[0-9]+:[0-9]+$" },
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "n_gen_tokens": { "type": "integer", "minimum": 0 },
    "confounds": {
      "type": "object",
      "required": ["temperature", "top_p", "top_k", "min_p", "decode_only", "mtp_off"],
      "properties": {
        "temperature": { "const": 0 },
        "top_p": { "const": 1.0 },
        "top_k": { "const": 0 },
        "min_p": { "const": 0.0 },
        "decode_only": { "type": "boolean", "const": true },
        "mtp_off": { "type": "boolean", "const": true }
      }
    },
    "provenance": { "$ref": "#/$defs/provenance" }
  },
  "$defs": {
    "provenance": {
      "type": "object",
      "required": ["engine_id", "model_hash", "llama_cpp_commit"],
      "properties": {
        "engine_id": { "type": "string" },
        "model_hash": { "type": "string" },
        "llama_cpp_commit": { "type": "string", "pattern": "^[0-9a-f]{9,40}$" },
        "atlas_stage": { "enum": ["A", "B", "C1", "C2", "C3"] },
        "host": { "type": "string" },
        "recorded_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}
